# vibe.Sınav Assessment System
# Environment Configuration Template
# Copy this file to .env and adjust values for your local or server environment.

# Application
APP_NAME="vibe.Sınav"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/ptmtest
APP_TIMEZONE=Asia/Karachi

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ptm_db
DB_USERNAME=root
DB_PASSWORD=

# Session
SESSION_LIFETIME=30
SESSION_NAME=vibe_sinav_session

# Security
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=8
